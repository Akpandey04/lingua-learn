      "id": "intro",
      "type": "knowledge_card",
      "config": {
        "title": "Who is doing the action?",
        "conceptId": "intro",
        "content": "To talk about who is doing an action, we use pronouns like 'I', 'You', 'We', and 'They'.\n\n- I = Main (myself)\n- You = Tum / Aap (the person I'm talking to)\n- We = Hum (me and others)\n- They = Ve / Wo (other people)",
        "example": "Let's see them in action."
      }
    },
