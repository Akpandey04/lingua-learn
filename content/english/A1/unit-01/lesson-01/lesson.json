{
  "id": "lesson-01",
  "unitId": "unit-01",
  "title": "Build Your First English Sentences",
  "version": 2,
  "learningObjectives": [
    "english_svo"
  ],
  "modules": [
    {
      "id": "intro",
      "type": "knowledge_card",
      "config": {
        "title": "Subject + Verb + Object",
        "conceptId": "intro",
        "content": "Today you will learn basic English word order.\n\nLook at this sentence:\n'I eat rice.'",
        "example": "I (Who?) → eat (Action?) → rice (What?)"
      }
    },
    {
      "id": "discover-1",
      "type": "quiz",
      "config": {
        "activities": [
          {
            "type": "mcq",
            "payload": {
              "id": "d-1",
              "type": "mcq",
              "phaseTitle": "Discover",
              "question": "Read: 'I drink coffee.' What do I drink?",
              "answer": "Coffee",
              "options": ["Coffee", "I", "Drink"],
              "conceptId": "english_svo"
            }
          }
        ]
      }
    },
    {
      "id": "explain-svo",
      "type": "knowledge_card",
      "config": {
        "title": "The Rule",
        "conceptId": "english_svo",
        "content": "In English, sentences usually follow this order:\n\n1. Subject (Who is doing it?)\n2. Verb (What is the action?)\n3. Object (Who or what receives the action?)\n\nExample:\nI (Subject) + drink (Verb) + coffee (Object).",
        "example": "Let's see some more examples."
      }
    },
    {
      "id": "examples-1",
      "type": "vocabulary",
      "config": {
        "flow": "teach_all",
        "words": [
          {
            "conceptId": "english_svo_examples",
            "emoji": "📱",
            "nativeWord": "I use my phone.",
            "englishMeaning": "Main apna phone use karta/karti hoon.",
            "pronunciation": "I use my phone",
            "exampleSentence": "I use my phone.",
            "exampleTranslation": "I use my phone.",
            "memoryTip": "I (Subject) + use (Verb) + my phone (Object)",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["Everyday actions"],
              "doNotUse": [],
              "insteadSay": ""
            }
          },
          {
            "conceptId": "english_svo_examples",
            "emoji": "📚",
            "nativeWord": "I study English.",
            "englishMeaning": "Main English padhta/padhti hoon.",
            "pronunciation": "I study English",
            "exampleSentence": "I study English.",
            "exampleTranslation": "I study English.",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["Everyday actions"],
              "doNotUse": [],
              "insteadSay": ""
            }
          },
          {
            "conceptId": "english_svo_examples",
            "emoji": "🏏",
            "nativeWord": "We play cricket.",
            "englishMeaning": "Hum cricket khelte hain.",
            "pronunciation": "We play cricket",
            "exampleSentence": "We play cricket.",
            "exampleTranslation": "We play cricket.",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["Everyday actions"],
              "doNotUse": [],
              "insteadSay": ""
            }
          }
        ]
      }
    },
    {
      "id": "build-sentence",
      "type": "quiz",
      "config": {
        "activities": [
          {
            "type": "sentence_build",
            "payload": {
              "id": "b-1",
              "type": "sentence_build",
              "phaseTitle": "Build the Sentence",
              "question": "Arrange the words to say: I drink coffee.",
              "tokens": ["coffee", "I", "drink"],
              "answer": "I drink coffee.",
              "conceptId": "english_svo"
            }
          },
          {
            "type": "sentence_build",
            "payload": {
              "id": "b-2",
              "type": "sentence_build",
              "phaseTitle": "Build the Sentence",
              "question": "Arrange the words to say: I study English.",
              "tokens": ["English", "I", "study"],
              "answer": "I study English.",
              "conceptId": "english_svo"
            }
          },
          {
            "type": "sentence_build",
            "payload": {
              "id": "b-3",
              "type": "sentence_build",
              "phaseTitle": "Build the Sentence",
              "question": "Arrange the words to say: They play football.",
              "tokens": ["football", "they", "play"],
              "answer": "They play football.",
              "conceptId": "english_svo"
            }
          }
        ]
      }
    },
    {
      "id": "choose-correct",
      "type": "quiz",
      "config": {
        "activities": [
          {
            "type": "mcq",
            "payload": {
              "id": "c-1",
              "type": "mcq",
              "phaseTitle": "Choose Correct",
              "question": "Which sentence is correct?",
              "answer": "I drink coffee.",
              "options": ["I coffee drink.", "I drink coffee.", "Drink I coffee."],
              "conceptId": "english_svo",
              "explanation": "English follows Subject (I) + Verb (drink) + Object (coffee)."
            }
          },
          {
            "type": "mcq",
            "payload": {
              "id": "c-2",
              "type": "mcq",
              "phaseTitle": "Choose Correct",
              "question": "Which sentence is correct?",
              "answer": "We eat dinner.",
              "options": ["We dinner eat.", "Eat we dinner.", "We eat dinner."],
              "conceptId": "english_svo",
              "explanation": "Subject (We) + Verb (eat) + Object (dinner)."
            }
          }
        ]
      }
    },
    {
      "id": "identify-parts",
      "type": "quiz",
      "config": {
        "activities": [
          {
            "type": "mcq",
            "payload": {
              "id": "i-1",
              "type": "mcq",
              "phaseTitle": "Identify the Parts",
              "question": "'My brother plays cricket.'\nWho is doing the action (Subject)?",
              "answer": "My brother",
              "options": ["My brother", "plays", "cricket"],
              "conceptId": "english_svo"
            }
          },
          {
            "type": "mcq",
            "payload": {
              "id": "i-2",
              "type": "mcq",
              "phaseTitle": "Identify the Parts",
              "question": "'My brother plays cricket.'\nWhat is the action (Verb)?",
              "answer": "plays",
              "options": ["My brother", "plays", "cricket"],
              "conceptId": "english_svo"
            }
          },
          {
            "type": "mcq",
            "payload": {
              "id": "i-3",
              "type": "mcq",
              "phaseTitle": "Identify the Parts",
              "question": "'My brother plays cricket.'\nWhat is the object?",
              "answer": "cricket",
              "options": ["My brother", "plays", "cricket"],
              "conceptId": "english_svo"
            }
          }
        ]
      }
    },
    {
