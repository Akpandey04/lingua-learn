          {
            "type": "sentence_build",
            "payload": {
              "id": "e-1",
              "type": "sentence_build",
              "phaseTitle": "Sentence Expansion",
              "question": "Start with: 'I study.' Add WHAT you study.",
              "tokens": ["I", "study", "English"],
              "answer": "I study English",
              "conceptId": "english_expansion"
            }
          },
          {
            "type": "sentence_build",
            "payload": {
              "id": "e-2",
              "type": "sentence_build",
              "phaseTitle": "Sentence Expansion",
              "question": "Now add WHERE.",
              "tokens": ["I", "study", "English", "at", "home"],
              "answer": "I study English at home",
              "conceptId": "english_expansion"
            }
          },
          {
            "type": "sentence_build",
            "payload": {
              "id": "e-3",
              "type": "sentence_build",
              "phaseTitle": "Sentence Expansion",
              "question": "Now add WHEN.",
              "tokens": ["I", "study", "English", "at", "home", "every", "evening"],
              "answer": "I study English at home every evening",
              "conceptId": "english_expansion"
            }
          }
        ]
      }
    },
