              "options": ["I coffee drink.", "I drink coffee.", "Drink I coffee."],
              "conceptId": "english_svo"
            }
          },
          {
            "type": "mcq",
            "payload": {
              "id": "tt-2",
              "type": "mcq",
              "phaseTitle": "Hindi Thought → English",
