  "modules": [
    {
      "id": "intro",
      "type": "knowledge_card",
      "config": {
        "title": "Modal Verb: COULD",
        "conceptId": "intro",
        "content": "'Could' is like the older, more polite brother of 'Can'.\n\nWe use it for:\n1. PAST ABILITY (What you were able to do in the past)\n   Example: I could swim when I was six.\n2. POLITE REQUESTS (Asking nicely, especially to seniors or strangers)\n   Example: Could you help me, please?",
        "example": "Let's see the difference!"
      }
    },
    {
      "id": "discover",
      "type": "vocabulary",
      "config": {
        "flow": "teach_all",
        "words": [
          {
            "conceptId": "modal_could",
            "emoji": "👶",
            "nativeWord": "I could run fast when I was young.",
            "englishMeaning": "Main jab chhota tha, tab tez daud sakta tha.",
            "pronunciation": "I could run fast",
            "exampleSentence": "I could run fast when I was young.",
            "exampleTranslation": "I could run fast when I was young.",
            "difficultyRating": 2,
            "contextualUsage": {
              "whenToUse": ["Talking about past abilities"],
              "doNotUse": ["For single actions in the past (Use 'was able to')"],
              "insteadSay": ""
            }
          },
          {
            "conceptId": "modal_could",
            "emoji": "👔",
            "nativeWord": "Could you help me?",
            "englishMeaning": "Kya aap meri madad kar sakte hain?",
            "pronunciation": "Could you help me",
            "exampleSentence": "Could you help me?",
            "exampleTranslation": "Could you help me?",
            "memoryTip": "Very polite. Better than 'Can you help me?' at work.",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["Asking politely at work, in shops, or to strangers"],
              "doNotUse": [],
              "insteadSay": ""
            }
          }
        ]
      }
    },
