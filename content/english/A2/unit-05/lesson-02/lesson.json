            "emoji": "🤝",
            "nativeWord": "Can you help me?",
            "englishMeaning": "Kya tum meri madad kar sakte ho?",
            "pronunciation": "Can you help me",
            "exampleSentence": "Can you help me?",
            "exampleTranslation": "Can you help me?",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["Asking a friend or coworker for help"],
              "doNotUse": ["When asking a very senior boss (use Could)"],
              "insteadSay": "Could you help me?"
            }
          },
          {
            "conceptId": "modal_can_requests",
            "emoji": "🧂",
