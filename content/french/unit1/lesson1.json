            "ipa": "/o ʁəvwaʁ/",
            "pronunciation": "Oh ruh-vwahr",
            "exampleSentence": "Au revoir Pierre !",
            "exampleTranslation": "Goodbye Pierre!",
            "memoryTip": "Au = Until, Revoir = See again.",
            "difficultyRating": 2,
            "contextualUsage": {
              "whenToUse": ["Leaving", "Ending conversation"],
              "doNotUse": ["Starting conversation"],
              "insteadSay": "Bonjour"
            }
          },
