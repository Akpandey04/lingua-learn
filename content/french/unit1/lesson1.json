            "conceptId": "politeness_merci",
            "emoji": "🙏",
            "nativeWord": "Merci",
            "englishMeaning": "Thank you",
            "ipa": "/mɛʁsi/",
            "pronunciation": "Mehr-see",
            "exampleSentence": "Merci beaucoup !",
            "exampleTranslation": "Thank you very much!",
            "memoryTip": "Sounds soft and polite.",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["After help", "Receiving something"],
              "doNotUse": [],
              "insteadSay": ""
            }
          }
        ]
      }
