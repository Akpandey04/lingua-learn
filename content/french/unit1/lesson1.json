          { "type": "listening", "payload": { "id": "l-2", "type": "listening", "phaseTitle": "Quick Listening", "audioText": "Salut", "answer": "Salut", "options": ["Bonjour", "Salut", "Bonsoir", "Au revoir"], "conceptId": "greeting_salut" } },
          { "type": "listening", "payload": { "id": "l-3", "type": "listening", "phaseTitle": "Quick Listening", "audioText": "Bonsoir", "answer": "Bonsoir", "options": ["Bonne nuit", "Bonjour", "Bonsoir", "Salut"], "conceptId": "greeting_bonsoir" } }
