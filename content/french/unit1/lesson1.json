        "title": "Welcome to Greetings",
        "conceptId": "intro",
        "content": "Today we will learn 6 essential French greetings. We will learn them in small chunks so you don't get overwhelmed.",
        "example": "Take your time and listen to the pronunciation."
      }
    },
    {
      "id": "learn-chunk-1",
      "type": "vocabulary",
      "config": {
        "flow": "teach_all",
        "words": [
          {
            "conceptId": "greeting_bonjour",
            "emoji": "☀️",
            "nativeWord": "Bonjour",
            "englishMeaning": "Hello / Good Morning",
            "ipa": "/bɔ̃ʒuʁ/",
            "pronunciation": "Bon-zhoor",
            "exampleSentence": "Bonjour Marie !",
            "exampleTranslation": "Hello Marie!",
            "memoryTip": "Bon = Good. Jour = Day. Good day.",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["Morning", "Afternoon"],
              "doNotUse": ["Night"],
              "insteadSay": "Bonsoir"
            },
            "commonMistake": {
              "wrong": "Saying Bonsoir in the morning",
              "correct": "Bonjour"
            }
          },
          {
            "conceptId": "greeting_salut",
            "emoji": "👋",
            "nativeWord": "Salut",
            "englishMeaning": "Hi / Bye (Casual)",
            "ipa": "/saly/",
            "pronunciation": "Sah-loo",
            "exampleSentence": "Salut Pierre !",
            "exampleTranslation": "Hi Pierre!",
            "memoryTip": "Salut is casual. Use it with friends.",
            "difficultyRating": 1,
            "contextualUsage": {
              "whenToUse": ["With friends", "Casual settings"],
              "doNotUse": ["Formal situations", "To a boss"],
              "insteadSay": "Bonjour"
            }
          },
          {
            "conceptId": "greeting_bonsoir",
            "emoji": "🌆",
            "nativeWord": "Bonsoir",
            "englishMeaning": "Good Evening",
            "ipa": "/bɔ̃swaʁ/",
            "pronunciation": "Bon-swahr",
            "exampleSentence": "Bonsoir Monsieur.",
            "exampleTranslation": "Good evening Sir.",
            "memoryTip": "Soir = Evening. Used after 6 PM.",
            "difficultyRating": 2,
            "contextualUsage": {
              "whenToUse": ["Evening", "After 6 PM"],
              "doNotUse": ["Morning"],
              "insteadSay": "Bonjour"
            },
            "commonMistake": {
              "wrong": "Saying Bonjour at 8 PM",
              "correct": "Bonsoir"
            }
          }
        ]
      }
    },
